import '../justfiles/go.just'

# Build ldflags string
_LDFLAGSSTRING := "'" + trim(
    "-X main.GitCommit=" + GITCOMMIT + " " + \
    "-X main.GitDate=" + GITDATE + " " + \
    "-X main.Version=" + VERSION + " " + \
    "") + "'"

BINARY := "./bin/op-supernode"
SUBMITTER_BINARY := "./bin/proofbatch-submitter"
INSPECT_BINARY := "./bin/proofbatch-inspect"

# Build op-supernode binary
op-supernode: (go_build BINARY "./cmd" "-ldflags" _LDFLAGSSTRING)

# Build proofbatch-submitter binary
proofbatch-submitter: (go_build SUBMITTER_BINARY "./cmd/proofbatch-submitter" "-ldflags" _LDFLAGSSTRING)

# This one takes no ldflags, unlike every other recipe here: the tool declares no
# version symbols, and -X against a symbol that does not exist is silently a
# no-op -- which reads, in a diff, like a version stamp is being applied.

# Build proofbatch-inspect binary
proofbatch-inspect: (go_build INSPECT_BINARY "./cmd/proofbatch-inspect")

# Clean build artifacts
clean:
    rm -f {{BINARY}} {{SUBMITTER_BINARY}} {{INSPECT_BINARY}}

# Run tests
test: (go_test "./...")

# Run tests with coverage report
coverage:
    @go test ./... -coverprofile=coverage.out
    @go tool cover -func=coverage.out | grep '^total:'
    @go tool cover -func=coverage.out | grep -v '^total:'


