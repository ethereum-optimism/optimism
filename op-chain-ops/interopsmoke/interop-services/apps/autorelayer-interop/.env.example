# ============================================================================
# Autorelayer Interop — Environment Variables
# ============================================================================
# Copy this file to .env and fill in values for your deployment.

# --------------------------------------------------------------------------
# Polling / loop configuration
# --------------------------------------------------------------------------

# How often (in milliseconds) the relayer polls for new messages to relay.
# Default: 2000 | Minimum: 2000
LOOP_INTERVAL_MS=2000

# --------------------------------------------------------------------------
# Service endpoints
# --------------------------------------------------------------------------

# URL of the Ponder interop indexer API. The relayer fetches chain config
# and pending messages from this endpoint.
# Default: http://127.0.0.1:42069
PONDER_INTEROP_API_URL=http://127.0.0.1:42069

# URL of the sponsored transaction endpoint. Used when SENDER_PRIVATE_KEY is
# NOT set — the relayer forwards relay transactions through this service
# instead of signing locally. Per-chain URLs are derived as
# <SPONSORED_ENDPOINT_URL>/<chainId>.
# Default: http://127.0.0.1:3000
# SPONSORED_ENDPOINT_URL=http://127.0.0.1:3000

# --------------------------------------------------------------------------
# Chain RPC overrides (optional)
# --------------------------------------------------------------------------

# Comma-separated list of RPC URLs to override the default endpoints
# returned by the Ponder API. Each URL is queried for its chain ID and
# matched to the corresponding chain entry.
# Example: https://rpc.chain-a.io,https://rpc.chain-b.io
CHAIN_ENDPOINT_OVERRIDES=https://interop-v0-0.optimism.io,https://interop-v0-1.optimism.io

# --------------------------------------------------------------------------
# Local signing (optional, conflicts with SPONSORED_ENDPOINT_URL)
# --------------------------------------------------------------------------

# Private key (hex-encoded, with 0x prefix) used to sign relay transactions
# locally. When set, SPONSORED_ENDPOINT_URL is ignored and the relayer
# creates wallet clients using this key on every chain.
SENDER_PRIVATE_KEY=

# --------------------------------------------------------------------------
# GasTank integration (optional)
# --------------------------------------------------------------------------

# Address of the GasTank contract. When set, the relayer uses the GasTank
# for gas accounting on relay transactions.
# GAS_TANK_ADDRESS=0x...

# --------------------------------------------------------------------------
# Promise contract (optional)
# --------------------------------------------------------------------------

# Address of the Promise contract used for cross-chain promise sharing.
# When set, the relayer will handle promise-related relay logic.
PROMISE_CONTRACT_ADDRESS=0xF94c51c00A72A92e8f31eE08e3b93Cab24FDF304
