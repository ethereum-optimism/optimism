{
  "shared_paths": [
    "docker-bake.hcl",
    ".github/workflows/build-images.yaml",
    ".github/images.json",
    ".github/actions/docker-build-prep/**",
    "ops/scripts/compute-git-versions.sh"
  ],
  "shared_go_paths": [
    "go.mod",
    "go.sum",
    "ops/docker/op-stack-go/**",
    "op-service/**",
    "op-core/**",
    "op-chain-ops/**",
    "ops/docker/melange/opstack-go.melange.yaml"
  ],
  "images": {
    "op-node": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-node",
      "paths": ["op-node/**", "ops/docker/apko/op-node.apko.yaml"]
    },
    "op-batcher": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-batcher",
      "paths": ["op-batcher/**", "ops/docker/apko/op-batcher.apko.yaml"]
    },
    "op-faucet": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-faucet",
      "paths": ["op-faucet/**", "ops/docker/apko/op-faucet.apko.yaml"]
    },
    "op-program": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-program",
      "paths": ["op-program/**", "op-preimage/**"]
    },
    "op-proposer": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-proposer",
      "paths": ["op-proposer/**", "ops/docker/apko/op-proposer.apko.yaml"]
    },
    "op-challenger": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-challenger",
      "paths": ["op-challenger/**", "op-program/**", "cannon/**", "op-preimage/**", "rust/kona/**"]
    },
    "op-dispute-mon": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-dispute-mon",
      "paths": ["op-dispute-mon/**", "ops/docker/apko/op-dispute-mon.apko.yaml"]
    },
    "op-conductor": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-conductor",
      "paths": ["op-conductor/**", "op-node/**", "ops/docker/apko/op-conductor.apko.yaml"]
    },
    "da-server": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "da-server",
      "paths": ["op-alt-da/**", "ops/docker/apko/da-server.apko.yaml"]
    },
    "op-supervisor": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-supervisor",
      "paths": ["op-supervisor/**", "ops/docker/apko/op-supervisor.apko.yaml"]
    },
    "op-supernode": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-supernode",
      "paths": ["op-supernode/**", "op-node/**", "ops/docker/apko/op-supernode.apko.yaml"]
    },
    "op-test-sequencer": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-test-sequencer",
      "paths": ["op-test-sequencer/**", "ops/docker/apko/op-test-sequencer.apko.yaml"]
    },
    "cannon": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "cannon",
      "paths": ["cannon/**", "op-preimage/**"]
    },
    "op-deployer": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-deployer",
      "paths": ["op-deployer/**", "packages/contracts-bedrock/**"]
    },
    "op-dripper": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-dripper",
      "paths": ["op-dripper/**", "ops/docker/apko/op-dripper.apko.yaml"]
    },
    "op-interop-mon": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-interop-mon",
      "paths": ["op-interop-mon/**", "ops/docker/apko/op-interop-mon.apko.yaml"]
    },
    "op-interop-filter": {
      "type": "go",
      "check": "go",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-interop-filter",
      "paths": ["op-interop-filter/**", "ops/docker/apko/op-interop-filter.apko.yaml"]
    },
    "kona-node": {
      "type": "rust",
      "check": "rust",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "kona-node",
      "paths": ["rust/**", "ops/docker/apko/kona-node.apko.yaml", "ops/docker/melange/opstack-kona.melange.yaml"]
    },
    "kona-client": {
      "type": "rust",
      "check": "none",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "kona-client",
      "paths": ["rust/**", "ops/docker/apko/kona-client.apko.yaml", "ops/docker/melange/opstack-kona.melange.yaml"]
    },
    "kona-host": {
      "type": "rust",
      "check": "rust",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "kona-host",
      "paths": ["rust/**", "ops/docker/apko/kona-host.apko.yaml", "ops/docker/melange/opstack-kona.melange.yaml"]
    },
    "op-reth": {
      "type": "rust",
      "check": "rust",
      "mode": "bake",
      "bake_file": "docker-bake.hcl",
      "target": "op-reth",
      "paths": ["rust/**", "ops/docker/apko/op-reth.apko.yaml", "ops/docker/melange/opstack-reth.melange.yaml"]
