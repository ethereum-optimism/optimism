{
  "version": 2,
  "registry": "us-docker.pkg.dev/oplabs-tools-artifacts/images",
  "shared_paths": [
    ".github/images.json",
    ".github/workflows/build-images.yaml",
    "melange/pipelines/**",
    "melange/op-stack-go.yaml",
    "melange/op-stack-rust.yaml",
    "melange/multicannon.yaml"
  ],
  "release": {
    "publish_tag": "${version}",
    "source_ref": "${ref_name}"
  },
  "packages": {
    "op-stack-go": {
      "config": "melange/op-stack-go.yaml"
    },
    "op-stack-rust": {
      "config": "melange/op-stack-rust.yaml",
      "submodules": "recursive",
      "use_gha_cache": true,
      "cache_key_files": [
        "rust/Cargo.lock"
      ],
      "runner_profile": "large",
      "cargo_profile": {
        "trusted": "maxperf",
        "untrusted": "fast-build"
      }
    },
    "kona-zkvm-canary": {
      "config": "melange/kona-zkvm-canary.yaml",
      "submodules": "recursive",
      "use_gha_cache": true,
      "cache_key_files": [
        "rust/Cargo.lock"
      ],
      "runner_profile": "large",
      "cargo_profile": {
        "trusted": "maxperf",
        "untrusted": "fast-build"
      }
    },
    "op-zk-proposer-cuda": {
      "config": "melange/op-zk-proposer-cuda.yaml",
      "runner_profile": "large"
    },
    "multicannon": {
      "config": "melange/multicannon.yaml"
    },
    "op-deployer": {
      "config": "melange/op-deployer.yaml",
      "submodules": "recursive"
    }
  },
  "images": {
    "da-server": {
      "builders": {
        "apko": {
          "needs_packages": [
            "op-stack-go"
          ],
          "configs": [
            {
              "config": "apko/da-server.yaml",
              "tag_suffix": ""
            },
            {
              "config": "apko/da-server-slim.yaml",
              "tag_suffix": "-slim"
            }
          ]
        }
      },
      "paths": [
        "op-alt-da/**",
        "apko/da-server.yaml",
        "apko/da-server-slim.yaml",
        "go.mod",
        "go.sum",
        "op-service/**",
        "op-core/**",
        "op-chain-ops/**"
      ],
      "smoke": {
        "commands": [
          "da-server --version"
        ],
        "verify_version": true
      }
    },
    "kona-client": {
      "builders": {
        "apko": {
          "needs_packages": [
            "op-stack-rust"
          ],
          "configs": [
