              "tag_suffix": ""
            },
            {
              "config": "apko/kona-client-slim.yaml",
              "tag_suffix": "-slim"
            }
          ]
        }
      },
      "paths": [
        "rust/**",
        "apko/kona-client.yaml",
        "apko/kona-client-slim.yaml"
      ],
      "smoke": {
        "commands": [
          "kona-client --help"
        ]
      }
    },
