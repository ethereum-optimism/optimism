#!/usr/bin/env bash
# CircleCI CLI stand-in. acceptance-tests.sh puts it first on PATH for RWX
# verdicts. It serves only the `circleci tests split <placement options> <file>`
# call in ops/scripts/shard-tests.sh; <file> holds every test name that the
# recipe listed. It prints the names that the discovery manifest assigns to shard
# CIRCLE_NODE_INDEX of CIRCLE_NODE_TOTAL, so placement options have no effect.
# It fails when <file> differs from discovery, and for every other invocation.
set -euo pipefail
unsupported() {
  echo "circleci: the RWX acceptance shim does not support: circleci $*" >&2
  exit 1
}
[[ $# -ge 3 && $1 == tests && $2 == split && ${!#} != -* ]] || unsupported "$@"
for option in "${@:3:$#-3}"; do
  case "$option" in
    --split-by=* | --timings-type=* | --time-default=*) ;;
    *) unsupported "$@" ;;
  esac
done
exec python3 "$(dirname "${BASH_SOURCE[0]}")/../acceptance-manifest.py" select \
  --directory "$CI_ACCEPTANCE_DISCOVERY" --index "$CIRCLE_NODE_INDEX" \
  --total "$CIRCLE_NODE_TOTAL" --listed "${!#}"
