      "receipt_task": "main-gate-receipt",
      "route": "run-main",
      "embedded_task": "native-go",
      "check_name": "optimism-go-tests-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1",
        "build-probe": "",
        "target-cache-mode": "keep",
        "shard-total": "12",
        "test-parallel": "8"
      },
      "receipt_if": "${{ init.cache-warm != 'true' && init.shard-total == '12' }}"
    },
    "main-acceptance": {
      "config": ".rwx/acceptance.yml",
      "receipt_task": "main-gate-receipt",
      "route": "run-main",
      "embedded_task": "native-acceptance",
      "check_name": "optimism-acceptance-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1",
        "build-probe": "",
        "target-cache-mode": "keep",
        "shard-total": "8"
      },
      "receipt_if": "${{ init.cache-warm != 'true' && init.shard-total == '8' }}"
    },
    "main-cannon": {
      "config": ".rwx/cannon-go.yml",
      "receipt_task": "main-gate-receipt",
      "route": "run-main",
      "embedded_task": "native-cannon",
      "check_name": "optimism-cannon-go-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1"
