  "groups": {
    "rust-fmt": {
      "config": ".rwx/pilot.yml",
      "receipt_task": "rust-gate-receipt",
      "route": "run-rust-ci",
      "embedded_task": "native-fmt",
      "check_name": "optimism-pilot",
      "init": {}
    },
    "rust-workspace": {
      "config": ".rwx/rust.yml",
      "receipt_task": "rust-gate-receipt",
      "route": "run-rust-ci",
      "embedded_task": "native-workspace",
      "check_name": "optimism-rust-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1"
      },
      "receipt_if": "${{ init.cache-warm != 'true' }}"
    },
    "op-reth-rust": {
      "config": ".rwx/op-reth.yml",
      "receipt_task": "rust-gate-receipt",
      "route": "run-rust-ci",
      "embedded_task": "native-op-reth",
      "check_name": "optimism-op-reth-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1",
        "build-probe": "",
        "target-cache-mode": "keep",
        "codec-base-sha": ""
      },
      "receipt_if": "${{ init.cache-warm != 'true' }}"
    },
    "main-pilot": {
      "config": ".rwx/pilot.yml",
      "receipt_task": "main-gate-receipt",
      "route": "run-main",
      "embedded_task": "native-fmt",
      "check_name": "optimism-pilot",
      "init": {}
    },
    "main-checks": {
      "config": ".rwx/pr-checks.yml",
      "receipt_task": "main-gate-receipt",
      "route": "run-main",
      "embedded_task": "native-pr-checks",
      "check_name": "optimism-pr-checks-shadow",
      "init": {
        "cache-warm": "false",
        "cache-epoch": "v1"
      },
