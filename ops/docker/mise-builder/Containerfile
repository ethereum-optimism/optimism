# Containerfile for building and testing the Boba/Optimism monorepo
# This image includes all necessary tools and dependencies to run `make build` and `make test`
#
# Build with:
#   podman build -t boba-builder -f ops/docker/mise-builder/Containerfile .
# Or to build without repo context:
#   podman build -t boba-builder --build-arg UPSTREAM_REF=develop ops/docker/mise-builder/

FROM docker.io/library/ubuntu:24.04

# Build argument for fetching mise.toml from upstream optimism
# (mise.toml now lives in the optimism submodule, not the boba repo)
ARG UPSTREAM_REF=develop
ARG UPSTREAM_URL=https://raw.githubusercontent.com/ethereum-optimism/optimism

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    git \
    curl \
    wget \
    ca-certificates \
    # Required for various tools
    libssl-dev \
    pkg-config \
    # Python build dependencies
    python3-dev \
    python3-pip \
    python3-venv \
    # Network tools
    netbase \
    # Required for some Go packages
    unzip \
    xz-utils \
    # Additional dependencies
    jq \
    file \
    # Clean up apt cache
    && rm -rf /var/lib/apt/lists/*

# Install mise (tool version manager) globally
RUN curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# Set up PATH for mise
ENV PATH="/usr/local/bin:/root/.local/share/mise/shims:${PATH}"

WORKDIR /tmp/mise-install

# Fetch mise.toml from upstream optimism repository
# This allows building the image without needing the repo as build context
RUN curl -fsSL "${UPSTREAM_URL}/${UPSTREAM_REF}/mise.toml" -o mise.toml

# Remove disabled tools from mise.toml that can't be installed
# These are fake dependencies tracked for versioning only
RUN sed -i '/^asterisc = /d' mise.toml && \
    sed -i '/^kontrol = /d' mise.toml && \
    sed -i '/^binary_signer = /d' mise.toml

# Configure mise to trust the mise.toml file
RUN mise trust

# Install all tools via mise
# This will install: Go, Rust, Python, Foundry, and all other tools defined in mise.toml
# Note: This may take a while as it compiles tools from source
RUN mise install --verbose --yes

# Verify key tools are installed
RUN mise exec -- go version && \
    mise exec -- forge --version && \
    mise exec -- just --version

# Set environment variables for mise
ENV MISE_DATA_DIR="/root/.local/share/mise"
ENV MISE_CONFIG_DIR="/root/.config/mise"

# Ensure mise shims are always in PATH for all shells (login shells)
RUN echo 'export PATH="/root/.local/share/mise/shims:$PATH"' >> /etc/profile.d/mise.sh && \
    chmod +x /etc/profile.d/mise.sh

# Also add to bashrc for non-login shells (used by make subshells)
RUN echo 'export PATH="/root/.local/share/mise/shims:$PATH"' >> /etc/bash.bashrc

# Set working directory for building
WORKDIR /workspace

# Add a helper script to initialize the environment
RUN echo '#!/bin/bash' > /usr/local/bin/init-env.sh && \
    echo '# Configure git to trust the workspace directory and submodules' >> /usr/local/bin/init-env.sh && \
    echo 'git config --global --add safe.directory /workspace 2>/dev/null || true' >> /usr/local/bin/init-env.sh && \
    echo 'git config --global --add safe.directory /workspace/optimism 2>/dev/null || true' >> /usr/local/bin/init-env.sh && \
    echo '# Rewrite SSH URLs to HTTPS for submodules (no SSH keys in container)' >> /usr/local/bin/init-env.sh && \
    echo 'git config --global url."https://github.com/".insteadOf "git@github.com:"' >> /usr/local/bin/init-env.sh && \
    echo '# Trust the workspace mise.toml if it exists (in submodule)' >> /usr/local/bin/init-env.sh && \
    echo 'if [ -f /workspace/optimism/mise.toml ]; then' >> /usr/local/bin/init-env.sh && \
    echo '  mise trust /workspace/optimism/mise.toml 2>/dev/null || true' >> /usr/local/bin/init-env.sh && \
    echo 'fi' >> /usr/local/bin/init-env.sh && \
    echo '# Also trust workspace root mise.toml if it exists' >> /usr/local/bin/init-env.sh && \
    echo 'if [ -f /workspace/mise.toml ]; then' >> /usr/local/bin/init-env.sh && \
    echo '  mise trust /workspace/mise.toml 2>/dev/null || true' >> /usr/local/bin/init-env.sh && \
    echo 'fi' >> /usr/local/bin/init-env.sh && \
    echo '# Ensure mise shims are in PATH' >> /usr/local/bin/init-env.sh && \
    echo 'export PATH="/root/.local/share/mise/shims:$PATH"' >> /usr/local/bin/init-env.sh && \
    echo '# Activate mise environment' >> /usr/local/bin/init-env.sh && \
    echo 'eval "$(mise activate bash)"' >> /usr/local/bin/init-env.sh && \
    echo 'exec "$@"' >> /usr/local/bin/init-env.sh && \
    chmod +x /usr/local/bin/init-env.sh

# Default command: start a shell with mise activated
ENTRYPOINT ["/usr/local/bin/init-env.sh"]
CMD ["/bin/bash"]

# ============================================================================
# Usage Instructions
# ============================================================================
#
# BUILD THE IMAGE:
# ----------------
# From repo root:
#   podman build -t boba-builder -f ops/docker/mise-builder/Containerfile .
#
# Without repo context (fetches mise.toml from upstream GitHub):
#   podman build -t boba-builder ops/docker/mise-builder/
#
# Build with tools from a specific upstream branch/tag:
#   podman build -t boba-builder --build-arg UPSTREAM_REF=op-node/v1.16.0 ops/docker/mise-builder/
#
# RUN THE CONTAINER:
# ------------------
# Interactive shell with repo mounted:
#   podman run -it --rm -v $(pwd):/workspace:Z boba-builder
#
# Then inside the container (git safe.directory configured automatically):
#   git submodule update --init --recursive
#   make build
#   make test
#
# One-off build command:
#   podman run --rm -v $(pwd):/workspace:Z boba-builder bash -c \
#     "git submodule update --init --recursive && make build"
#
# Build specific target:
#   podman run --rm -v $(pwd):/workspace:Z boba-builder bash -c \
#     "git submodule update --init --recursive && make op-node"
#
# ============================================================================
