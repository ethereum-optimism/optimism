build:
  go build -o bin/op-fetcher cmd/main.go

build-go: build
build-all: build-contracts build-go

compile-contracts:
  #!/bin/bash
  set -euo pipefail
  cd ../packages/contracts-bedrock
  just clean
  just build-dev --deny-warnings --skip test

# Update the embedded artifacts only when explicitly building them for development.
# CI uses compile-contracts so its comparison sees the committed artifact bytes.
build-contracts: compile-contracts
  #!/bin/bash
  set -euo pipefail
  mkdir -p ./pkg/fetcher/fetch/forge-artifacts
  python3 ../ops/ci/fetcher-artifacts.py --export
