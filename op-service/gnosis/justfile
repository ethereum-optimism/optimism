# Variables
GNOSIS_PRIVATE_KEY := "ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
RPC_URL := "http://localhost:8545"

install-contracts:
    cd contracts && forge install && forge build

# Start anvil in background
start-anvil:
    @echo "Starting anvil..."
    anvil --host 0.0.0.0 --port 8545 > anvil.log 2>&1 &
    sleep 2
    @echo "Anvil started"

# Deploy Safe contracts
deploy-safe:
    #!/usr/bin/env bash
    set -euo pipefail
    export GNOSIS_PRIVATE_KEY={{GNOSIS_PRIVATE_KEY}}
    echo "Deploying Safe contracts..."
    cd contracts
    forge script script/DeploySafe.s.sol:DeploySafe \
        --rpc-url {{RPC_URL}} \
        --broadcast \
        --private-key $GNOSIS_PRIVATE_KEY
    cd ..
    echo "Safe contracts deployed"

# Run integration tests
test-integration:
    @echo "Running integration tests..."
    GNOSIS_INTEGRATION_TEST=true go test -v ./integration_test/... --count=1

# Stop anvil and clean up
cleanup:
    @echo "Cleaning up..."
    -pkill -f "anvil"
    -rm -f anvil.log
    @echo "Cleanup complete"

# Run full integration test suite
integration-test: install-contracts start-anvil deploy-safe test-integration cleanup

# Setup only (start anvil and deploy contracts)
setup: start-anvil deploy-safe

# List all available recipes
list:
    @just --list