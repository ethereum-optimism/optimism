import '../justfiles/go.just'

_LDFLAGSSTRING := "'" + trim(
    "-X main.Version=" + VERSION + " " + \
    "-X main.VersionMeta=" + VERSION_META + " " + \
    "-X main.GitCommit=" + GITCOMMIT + " " + \
    "-X main.GitDate=" + GITDATE + " " + \
    "") + "'"

BINARY := "./bin/op-up"

default: op-up

op-up: (go_build BINARY "." "-ldflags" _LDFLAGSSTRING)

artifacts:
    #!/usr/bin/env bash
    set -euo pipefail
    cd ../op-deployer
    just build-contracts
    mkdir -p ../artifacts/compressed
    go run ./pkg/deployer/artifacts/cmd/mktar \
      -base ../packages/contracts-bedrock \
      -out ../artifacts/compressed/artifacts.tzst \
      --exclude="*.t.sol"

clean:
    rm -f {{ BINARY }}
