default:
  @just --list

SP1_TAG := "v6.10.0"

# Build the super-range-executor host binary, used by acceptance smoke tests to run the
# super-range guest in SP1 execute mode. The binary loads the guest ELF at runtime, so build the
# test ELFs first (build-elfs test-config-fallback) and set KONA_SP1_ELF_DIR before
# running synthetic-chain tests without --native-core. Pass `sp1-sdk/profiling` as features for
# per-label cycle counts in `--report`.
build-super-range-executor features="":
    cd ../.. && cargo build -p kona-sp1-super-range-executor --release --features "{{features}}"

# Build all ELF files.
# ELF builds use the nested guest workspace with SP1 precompile-patched crypto,
# including substrate-bn for bn128 through revm-precompile's `bn` feature.
build-elfs features="":
    #!/usr/bin/env bash
    set -euo pipefail
    export KONA_SP1_GIT_SHA="$(just _git-sha "{{features}}")"
    m=elf/vkeys.toml
    just _vkeys-header > "$m"
    just build-log-commitment-elf
    just _append-vkey log-commitment "$m"
    just build-super-range-elf "{{features}}"
    just _append-vkey super-range "$m"
    just build-super-aggregation-elf
    just _append-vkey super-aggregation "$m"

# Check that the guest ELFs in DIR pin each other's vkeys as op-zk-proposer requires, match
# DIR/vkeys.toml if present, and that the super-aggregation vkey is PRESTATE if given.
verify-elfs DIR="elf" PRESTATE="":
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{DIR}}"
    for name in log-commitment super-range super-aggregation; do
      [ -s "${dir}/${name}-elf" ] || { echo "ERROR: missing or empty ${dir}/${name}-elf" >&2; exit 1; }
    done

    failed=0
    fail() { echo "FAIL: $*" >&2; failed=1; }

    log_vkey=$(just _derive-vkey "${dir}/log-commitment-elf")
    range_vkey=$(just _derive-vkey "${dir}/super-range-elf")
    agg_vkey=$(just _derive-vkey "${dir}/super-aggregation-elf")

    report() {
      markers=$(grep -aoE 'KONA_SP1_BUILD\{git_sha=[0-9A-Za-z._-]*\}' "${dir}/$1-elf" | sort -u | paste -sd ' ' - || true)
      echo "$1: vkey $2 marker ${markers:-<none>}"
    }
    report log-commitment "$log_vkey"
    report super-range "$range_vkey"
    report super-aggregation "$agg_vkey"

    prestate=$(echo "{{PRESTATE}}" | tr 'A-F' 'a-f')
    if [ -n "$prestate" ] && [ "$prestate" != "$agg_vkey" ]; then
      fail "super-aggregation vkey ${agg_vkey} is not the prestate ${prestate}"
    fi

    manifest="${dir}/vkeys.toml"
    check_manifest() {
      listed=$(sed -nE 's/^'"$1"' = "([^"]*)"$/\1/p' "$manifest" | tr 'A-F' 'a-f')
      [ "$listed" = "$2" ] || fail "${manifest} lists $1 = ${listed:-<none>}, but its ELF has vkey $2"
    }
    if [ -f "$manifest" ]; then
      check_manifest log-commitment "$log_vkey"
      check_manifest super-range "$range_vkey"
      check_manifest super-aggregation "$agg_vkey"
    else
      echo "no ${manifest}; skipping the manifest check"
    fi

    check_pin() {
      n=$(python3 scripts/count-pinned-vkey.py "${dir}/$1-elf" "$3")
      [ "$n" = 1 ] || fail "$1-elf embeds the $2 vkey $3 $n times, expected exactly once"
    }
    check_pin super-aggregation super-range "$range_vkey"
    check_pin super-range log-commitment "$log_vkey"

    [ "$failed" -eq 0 ] || exit 1
    echo "OK: ${dir} is a consistent guest set for prestate ${agg_vkey}"

# Run verify-elfs on the published guest ELFs for PRESTATE.
verify-published-elfs PRESTATE URL="https://storage.googleapis.com/oplabs-network-data/proofs/kona/sp1":
    #!/usr/bin/env bash
    set -euo pipefail
    prestate=$(echo "{{PRESTATE}}" | tr 'A-F' 'a-f')
    [[ "$prestate" =~ ^0x[0-9a-f]{64}$ ]] || { echo "ERROR: PRESTATE must be a 0x-prefixed bytes32 hex value" >&2; exit 1; }
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    for object in log:log-commitment range:super-range agg:super-aggregation; do
      url="{{URL}}/${prestate}.${object%%:*}.bin.gz"
      echo "Fetching ${url}"
      curl -fsSL --retry 3 "$url" | gunzip > "${dir}/${object#*:}-elf"
    done
    just verify-elfs "$dir" "$prestate"

# Build ELF file for the per-block log-commitment program.
# Does not update elf/vkeys.toml; prefer build-elfs.
[private]
build-log-commitment-elf:
    @just _build-elf log-commitment docker

# Build ELF file for the unified super-root range/consolidation program.
# Does not update elf/vkeys.toml; prefer build-elfs.
[private]
build-super-range-elf features="":
    @just _build-elf super-range docker "{{features}}"

# Build ELF file for the super-aggregation program.
# Does not update elf/vkeys.toml; prefer build-elfs.
[private]
build-super-aggregation-elf:
    @just _build-elf super-aggregation docker

# Install the native Succinct toolchain for non-Docker builds.
install-sp1-toolchain:
    cargo prove install-toolchain

# Build the test-only EIP-2537 BLS12-381 zkVM check guest into elf/ (not part of build-elfs).
build-bls12-381-check-elf:
    #!/usr/bin/env bash
    set -euo pipefail
    export KONA_SP1_GIT_SHA="$(just _git-sha)"
    just _build-elf bls12-381-check native "" tests/bls12-381-check

# Execute elf/bls12-381-check-elf in SP1's CPU executor and print per-op cycle counts.
run-bls12-381-check:
    cd ../.. && KONA_SP1_ELF_DIR="{{justfile_directory()}}/elf" cargo run --release --locked -p kona-sp1-bls12-381-check --example zkvm_check

# Build + run the BLS12-381 zkVM differential check (requires `just install-sp1-toolchain`).
check-bls12-381-zkvm: build-bls12-381-check-elf run-bls12-381-check

# Build the test-only hash-collision regression check guest into elf/ (not part of build-elfs).
build-hashdos-check-elf:
    #!/usr/bin/env bash
    set -euo pipefail
    export KONA_SP1_GIT_SHA="$(just _git-sha)"
    just _build-elf hashdos-check native "" tests/hashdos-check

# Execute elf/hashdos-check-elf in SP1's CPU executor with colliding and control TSTORE keys.
run-hashdos-check:
    cd ../.. && KONA_SP1_ELF_DIR="{{justfile_directory()}}/elf" cargo run --release --locked -p kona-sp1-super-range-executor --example hashdos_check

# Build + run the zkVM hash-collision regression check (requires `just install-sp1-toolchain`).
check-hashdos-zkvm: build-hashdos-check-elf run-hashdos-check

[private]
_build-elf NAME MODE features="" DIR="":
    #!/usr/bin/env bash
    set -euo pipefail

    root="$(cd "{{justfile_directory()}}/../../.." && pwd)"
    staged_configs=""

    cleanup() {
      if [[ -n "$staged_configs" ]]; then
        rm -rf "$staged_configs"
      fi
    }
    trap cleanup EXIT

    if [[ -n "${KONA_CUSTOM_CONFIGS_DIR:-}" ]]; then
      custom_configs_dir="$(realpath "$KONA_CUSTOM_CONFIGS_DIR")"
      for file in chainList.json configs.json depsets.json; do
        [[ -f "${custom_configs_dir}/${file}" ]] || {
          echo "ERROR: missing ${custom_configs_dir}/${file}" >&2
          exit 1
        }
      done

      if [[ "{{MODE}}" == "docker" ]]; then
        mkdir -p "${root}/target"
        staged_configs="$(mktemp -d "${root}/target/sp1-custom-configs.XXXXXX")"
        cp "${custom_configs_dir}/chainList.json" "${staged_configs}/"
        cp "${custom_configs_dir}/configs.json" "${staged_configs}/"
        cp "${custom_configs_dir}/depsets.json" "${staged_configs}/"
        docker_configs_dir="/root/program/${staged_configs#"${root}/"}"
      else
        export KONA_CUSTOM_CONFIGS=true
        export KONA_CUSTOM_CONFIGS_DIR="$custom_configs_dir"
      fi
    fi

    # Commit for kona-sp1-build-info's marker, resolved by the calling recipe so the production
    # guests carry the same one; see crates/build-info/build.rs for the two channels.
    : "${KONA_SP1_GIT_SHA:?resolve it via build-elfs or build-elfs-native}"
    export KONA_SP1_GIT_SHA

    # --locked appears to be a no-op in upstream cargo-prove (regenerates the lock anyway).
    args=(--locked --ignore-rust-version --elf-name "{{NAME}}-elf" --workspace-directory "$root" --output-directory "{{justfile_directory()}}/elf")
    if [[ "{{MODE}}" == "docker" ]]; then
      mkdir -p "{{justfile_directory()}}/programs/target/elf-compilation/docker"
      args=(--docker --tag "{{SP1_TAG}}" "${args[@]}")
      args+=(
        --rustflags=--cfg
        "--rustflags=kona_sp1_git_sha=\"${KONA_SP1_GIT_SHA}\""
      )
      if [[ -n "${docker_configs_dir:-}" ]]; then
        args+=(
          --rustflags=--cfg
          '--rustflags=kona_custom_configs="true"'
          --rustflags=--cfg
          "--rustflags=kona_custom_configs_dir=\"${docker_configs_dir}\""
        )
      fi
    fi

    if [[ "{{NAME}}" == "super-range" && -n "{{features}}" ]]; then
      args+=(--features "{{features}}")
    fi

    program_dir="{{DIR}}"
    cd "{{justfile_directory()}}/programs/${program_dir:-{{NAME}}}"
    cargo prove build "${args[@]}"

    # Nothing fails at compile time if the marker literal is dropped or an injection channel
    # stops working, so check the artifact on every build path rather than only the one CI runs.
    # Every distinct marker, so a second conflicting one fails rather than hiding behind the
    # first. The character class excludes control bytes, which would otherwise reach a terminal.
    elf="{{justfile_directory()}}/elf/{{NAME}}-elf"
    markers=$(grep -aoE 'KONA_SP1_BUILD\{git_sha=[0-9A-Za-z._-]*\}' "$elf" | sort -u || true)
    if [[ "$markers" != "KONA_SP1_BUILD{git_sha=${KONA_SP1_GIT_SHA}}" ]]; then
      echo "ERROR: {{NAME}}-elf build markers: ${markers:-<none>}" >&2
      echo "       expected exactly KONA_SP1_BUILD{git_sha=${KONA_SP1_GIT_SHA}}" >&2
      exit 1
    fi

# Commit recorded in the guest build marker. Resolved once per build so the guests built together
# agree.
# `-custom` marks a KONA_CUSTOM_CONFIGS_DIR build: those compile chain configs from outside the
# repo into the guest, so the commit alone does not describe the artifact.
[private]
_git-sha features="":
    #!/usr/bin/env bash
    set -euo pipefail
    root="$(cd "{{justfile_directory()}}/../../.." && pwd)"
    sha="$(git -C "$root" rev-parse HEAD)"
    git -C "$root" diff --quiet HEAD || sha="${sha}-dirty"
    [[ -z "${KONA_CUSTOM_CONFIGS_DIR:-}" ]] || sha="${sha}-custom"
    [[ -z "{{features}}" ]] || sha="${sha}-test"
    echo "$sha"

[private]
_vkeys-header:
    #!/usr/bin/env bash
    set -euo pipefail
    echo '# Generated SP1 guest verification-key hashes (bytes32).'
    echo '# Regenerate on linux/amd64 via "just build-elfs".'
    echo 'sp1_toolchain_tag = "{{SP1_TAG}}"'
    echo "git_sha = \"${KONA_SP1_GIT_SHA:-$(just _git-sha)}\""
    echo ''

[private]
_derive-vkey ELF:
    #!/usr/bin/env bash
    set -euo pipefail
    hash=$(SP1_PROVER=cpu cargo prove vkey --elf "{{ELF}}" | grep -oE '0x[0-9a-fA-F]{64}' || true)
    [ "$(printf '%s\n' "$hash" | grep -c .)" -eq 1 ] || {
      echo "ERROR: expected one bytes32 vkey for {{ELF}}, got: ${hash:-<none>}" >&2
      exit 1
    }
    echo "$hash" | tr 'A-F' 'a-f'

[private]
_append-vkey NAME MANIFEST:
    #!/usr/bin/env bash
    set -euo pipefail
    hash=$(just _derive-vkey "elf/{{NAME}}-elf")
    echo "{{NAME}} = \"${hash}\"" >> "{{MANIFEST}}"

# Build all ELFs natively for fast local iteration.
build-elfs-native features="":
    #!/usr/bin/env bash
    set -euo pipefail
    export KONA_SP1_GIT_SHA="$(just _git-sha "{{features}}")"
    m=elf/vkeys.toml
    just _vkeys-header > "$m"
    for name in log-commitment super-range super-aggregation; do
      just _build-elf "${name}" native "{{features}}"
      just _append-vkey "${name}" "$m"
    done
