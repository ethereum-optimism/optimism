default:
  @just --list

# Extra cargo features compiled into the bench binaries.
# GPU proving: `SP1_PROVER=cuda just features=gpu range-bench --start A --end B --prove`.
features := ""

# Build all ELF files.
build-elfs: build-range-elfs build-agg-elf

# Build ELF files for range programs.
build-range-elfs:
    #!/usr/bin/env bash

    cd programs/range
    # Mount the monorepo root so kona-hardforks can find op-core/nuts/bundles.
    ~/.sp1/bin/cargo-prove prove build --elf-name range-elf --docker --tag v6.2.4 --workspace-directory ../../../../.. --output-directory ../../elf

# Build ELF file for aggregation program.
build-agg-elf:
    #!/usr/bin/env bash

    cd programs/aggregation
    # Mount the monorepo root so kona-hardforks can find op-core/nuts/bundles.
    ~/.sp1/bin/cargo-prove prove build --elf-name aggregation-elf --docker --tag v6.2.4 --workspace-directory ../../../../.. --output-directory ../../elf

# Run the local range-program benchmark. Build the ELF first with `just build-elfs`.
# Hardware acceleration: use `SP1_PROVER=cuda` with `features=gpu` for GPU
# proving, or `RUSTFLAGS="-C target-cpu=native"` for vectorized CPU proving.
# Usage: just range-bench --start <N> --end <M> [--prove] [--save-proof <PATH>]
range-bench *ARGS:
    cargo run --release -p kona-sp1-range-bench {{ if features != "" { "--features " + features } else { "" } }} --bin range-bench -- {{ARGS}}

# Aggregate saved compressed range proofs. Generate them first with:
#   just range-bench --start A --end B --prove --save-proof a.bin
#   just range-bench --start B --end C --prove --save-proof b.bin
# Hardware acceleration: use `SP1_PROVER=cuda` with `features=gpu` for GPU
# proving, or `RUSTFLAGS="-C target-cpu=native"` for vectorized CPU proving.
# Usage: just agg-bench --proofs a.bin,b.bin [--prove]
agg-bench *ARGS:
    cargo run --release -p kona-sp1-range-bench {{ if features != "" { "--features " + features } else { "" } }} --bin agg-bench -- {{ARGS}}

# Benchmark local PLONK compression of the final aggregation proof.
# Always proves. Generate compressed range proofs first, e.g.:
#   just range-bench --start A --end B --prove --save-proof a.bin
#   just range-bench --start B --end C --prove --save-proof b.bin
# Hardware acceleration: use `SP1_PROVER=cuda` with `features=gpu` for GPU
# proving, or `RUSTFLAGS="-C target-cpu=native"` for vectorized CPU proving.
# Default local CPU PLONK requires Docker running for the gnark wrap and outbound
# network on first run for artifacts.
# Usage: just plonk-prove-bench --proofs a.bin,b.bin [--save-proof agg.plonk.bin]
plonk-prove-bench *ARGS:
    cargo run --release -p kona-sp1-range-bench {{ if features != "" { "--features " + features } else { "" } }} --bin plonk-prove-bench -- {{ARGS}}
