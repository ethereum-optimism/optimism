# Parameter variables
ACCEPTOR_VERSION := env_var_or_default("ACCEPTOR_VERSION", "v0.1.1")
DOCKER_REGISTRY := env_var_or_default("DOCKER_REGISTRY", "us-docker.pkg.dev/oplabs-tools-artifacts/images")
ACCEPTOR_IMAGE := env_var_or_default("ACCEPTOR_IMAGE", DOCKER_REGISTRY + "/op-acceptor:" + ACCEPTOR_VERSION)

# Internal variables
REPO_ROOT := `realpath ..`
KURTOSIS_DIR := REPO_ROOT + "/kurtosis-devnet"
BIN_DIR := ".bin"
SYSTEM_ARCH := `OS=$(uname -s | tr '[:upper:]' '[:lower:]'); ARCH=$(uname -m | sed 's/x86_64/amd64/' | sed 's/arm64/arm64/'); echo "$OS-$ARCH"`
ACCEPTOR_BINARY := BIN_DIR + "/op-acceptor-" + SYSTEM_ARCH

# Default recipe - runs acceptance tests
default:
    @just acceptance-test

# Run acceptance tests with native binary when possible, falling back to Docker if need be
acceptance-test devnet="simple" gate="localnet":
    #!/usr/bin/env bash
    set -euo pipefail

    # Ensure binary directory exists
    mkdir -p {{BIN_DIR}} || true

    # Check if binary exists and is executable
    if [ ! -f "{{ACCEPTOR_BINARY}}" ] || [ ! -x "{{ACCEPTOR_BINARY}}" ]; then
        echo "Binary not found, attempting to download..."

        # Try to download the binary, else fall back to Docker
        if ! just _download-binary {{ACCEPTOR_VERSION}} {{SYSTEM_ARCH}}; then
            echo "Download failed, falling back to Docker"
            just acceptance-test-docker {{devnet}} {{gate}}
            exit $?
        fi
    fi

    # Run the appropriate devnet from the kurtosis-devnet directory if needed.
    # We ignore failures here because if the devnet is already running then this command will fail.
    just {{KURTOSIS_DIR}}/{{ devnet }}-devnet || true

    # Print which binary is being used (for debugging)
    echo "Using native binary: {{ACCEPTOR_BINARY}}"

    # Run the native op-acceptor binary
    {{ACCEPTOR_BINARY}} \
        --testdir "{{REPO_ROOT}}" \
        --gate {{gate}} \
        --validators ./acceptance-tests.yaml \
        --log.level debug

# Run acceptance tests against a devnet using Docker
acceptance-test-docker devnet="simple" gate="localnet":
    #!/usr/bin/env bash
    set -euo pipefail

    # First run the appropriate devnet from the kurtosis-devnet directory if needed.
    # We ignore failures here because if the devnet is already running then this command will fail.
    just {{KURTOSIS_DIR}}/{{ devnet }}-devnet || true

    # Print which image is being used (for debugging)
    echo "Using acceptor image: {{ACCEPTOR_IMAGE}}"

    # Run op-acceptor with the repository mounted at the correct Go module path
    docker run \
        -v "$(pwd)/acceptance-tests.yaml:/acceptance-tests.yaml" \
        -v "{{REPO_ROOT}}:/go/src/github.com/ethereum-optimism/optimism" \
        {{ACCEPTOR_IMAGE}} \
        --testdir "/go/src/github.com/ethereum-optimism/optimism" \
        --gate {{gate}} \
        --validators /acceptance-tests.yaml \
        --log.level debug

# Helper to download the native binary from GitHub releases (internal use)
_download-binary version arch:
    #!/usr/bin/env bash
    set -euo pipefail

    # Remove 'v' prefix from version for filename
    VERSION_NO_V=`echo "{{version}}" | sed 's/^v//'`
    echo "Downloading op-acceptor {{version}} (${VERSION_NO_V}) for {{arch}}..."
    mkdir -p {{BIN_DIR}}

    # Define file paths
    DOWNLOAD_URL="https://github.com/ethereum-optimism/infra/releases/download/op-acceptor%2F{{version}}/op-acceptor-${VERSION_NO_V}-{{arch}}.tar.gz"
    TARBALL="{{BIN_DIR}}/op-acceptor-${VERSION_NO_V}-{{arch}}.tar.gz"
    BINARY_PATH="{{BIN_DIR}}/op-acceptor-{{arch}}"

    echo "URL: ${DOWNLOAD_URL}"

    # Download the tarball
    if curl -L -f "${DOWNLOAD_URL}" -o "${TARBALL}"; then
        echo "Downloaded tarball, extracting..."

        # Extract the binary from the tarball
        tar -xzf "${TARBALL}" -C "{{BIN_DIR}}"

        # The extracted binary might be named differently, need to find and rename it
        EXTRACTED_BINARY=$(find {{BIN_DIR}} -type f -name "op-acceptor*" ! -name "*.tar.gz" | head -n 1)

        if [ -n "${EXTRACTED_BINARY}" ]; then
            # Move the binary to the expected path
            mv "${EXTRACTED_BINARY}" "${BINARY_PATH}"
            chmod +x "${BINARY_PATH}"
            echo "Extracted binary to ${BINARY_PATH}"

            # Clean up the tarball
            rm "${TARBALL}"

            exit 0
        else
            echo "Failed to find extracted binary"
            exit 1
        fi
    else
        echo "Failed to download binary from ${DOWNLOAD_URL}"
        exit 1
    fi

# Manually download a specific binary version and architecture
download-binary version="{{ACCEPTOR_VERSION}}" arch="{{SYSTEM_ARCH}}":
    just _download-binary {{version}} {{arch}}

# Clean up downloaded binaries
clean:
    rm -rf {{BIN_DIR}}
