REPO_ROOT := `realpath ..`  # path to the root of the optimism monorepo

# Default recipe - runs acceptance tests
default:
    @just acceptance-test

# Build all dependencies for local acceptance test runs. Skipped in CI where jobs handle this.
build-deps:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "${CIRCLECI:-}" ]]; then exit 0; fi

    echo "Building contracts (local build)..."
    cd "{{REPO_ROOT}}"
    echo " - Installing mise..."
    mise install
    cd packages/contracts-bedrock
    echo " - Installing contracts..."
    just install
    echo " - Forge build..."
    just build-no-tests
    cd "{{REPO_ROOT}}"

    echo "Building cannon dependencies..."
    cd "{{REPO_ROOT}}"
    just cannon-prestates

    echo "Building Rust binaries (kona-node, kona-host, op-reth)..."
    cd "{{REPO_ROOT}}"
    just build-rust-release

# Run specific acceptance tests. Builds dependencies first, then passes all arguments to go test.
# Defaults `-count=1` and `-timeout 30m` are applied only when not already set in args,
# so callers can override either (e.g. `just test -count=10 -run TestFoo ./...`).
# Examples:
#   just test ./op-acceptance-tests/tests/base/...
#   just test -run TestMyTest ./op-acceptance-tests/tests/base/
#   just test -count=10 -run TestMyTest ./op-acceptance-tests/tests/base/
[positional-arguments]
test *args: build-deps
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{REPO_ROOT}}"
    flags=()
    case " $* " in
        *" -count="*|*" -count "*) ;;
        *) flags+=(-count=1) ;;
    esac
    case " $* " in
        *" -timeout="*|*" -timeout "*) ;;
        *) flags+=(-timeout 30m) ;;
    esac
    exec go test "${flags[@]}" "$@"

# Run acceptance tests
acceptance-test:
    #!/usr/bin/env bash
    set -euo pipefail
    echo -e "DEVNET: in-memory\n"

    LOG_LEVEL="$(echo "${LOG_LEVEL:-info}" | grep -E '^(debug|info|warn|error)$' || echo 'info')"
    echo "LOG_LEVEL: $LOG_LEVEL"

    CPU_COUNT=""
    if command -v nproc >/dev/null 2>&1; then
        CPU_COUNT="$(nproc)"
    elif command -v getconf >/dev/null 2>&1; then
        CPU_COUNT="$(getconf _NPROCESSORS_ONLN)"
    elif command -v sysctl >/dev/null 2>&1; then
        CPU_COUNT="$(sysctl -n hw.ncpu)"
    fi
    if [[ -z "$CPU_COUNT" || "$CPU_COUNT" -lt 1 ]]; then
        CPU_COUNT=1
    fi

    # Each ParallelT acceptance test spins its own full devstack (L1 geth +
    # op-node + op-reth/op-geth + batcher + proposer + challenger), so the real
    # cost driver is concurrent ParallelT goroutines, bounded by jobs * -parallel.
    # The previous unbounded default (-p = CPU_COUNT ~= 20, -parallel = ~10)
    # saturated CPU+RAM and triggered mass "context deadline exceeded" failures
    # across the runner — see ethereum-optimism/optimism#20966.
    #
    # Collapse to a single concurrency axis: each top-level test gets its own
    # `go test -parallel=1`, and xargs -P directly caps concurrent test devstacks
    # across the runner. 8 is what CI runs.
    DEFAULT_JOBS=8
    DEFAULT_TEST_PARALLEL=1

    JOBS="${ACCEPTANCE_TEST_JOBS:-$DEFAULT_JOBS}"
    # xargs -P 0 means no cap, or 100 on BusyBox.
    [ "$JOBS" -gt 0 ] || { echo "error: ACCEPTANCE_TEST_JOBS must be a positive integer" >&2; exit 1; }
    TEST_PARALLEL="${ACCEPTANCE_TEST_PARALLEL:-$DEFAULT_TEST_PARALLEL}"
    TEST_TIMEOUT="${ACCEPTANCE_TEST_TIMEOUT:-30m}"
    echo "CPU COUNT: $CPU_COUNT"
    echo "TEST JOBS: $JOBS"
    echo "TEST PARALLELISM: $TEST_PARALLEL"
    echo "TEST TIMEOUT: $TEST_TIMEOUT"
    export ACCEPTANCE_TEST_JOBS="$JOBS" ACCEPTANCE_TEST_PARALLEL="$TEST_PARALLEL"
    export ACCEPTANCE_TEST_TIMEOUT="$TEST_TIMEOUT" LOG_LEVEL

    cd "{{REPO_ROOT}}"
    if ! command -v gotestsum >/dev/null; then
        echo "error: gotestsum is required for acceptance-test runs." >&2
        exit 1
    fi

    LOG_ROOT="{{REPO_ROOT}}/op-acceptance-tests/logs"
    RESULTS_DIR="{{REPO_ROOT}}/op-acceptance-tests/results"
    mkdir -p "$LOG_ROOT" "$RESULTS_DIR"
    LOG_DIR="$LOG_ROOT/testrun-$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$LOG_DIR/failed"
    rm -f "$RESULTS_DIR"/results*.xml

    FLAKY_REPORT="$LOG_DIR/flaky-tests.txt"
    if command -v rg >/dev/null 2>&1; then
        rg -n "MarkFlaky\\(" ./op-acceptance-tests/tests > "$FLAKY_REPORT" || true
    else
        grep -RIn "MarkFlaky(" ./op-acceptance-tests/tests > "$FLAKY_REPORT" || true
    fi

    TEST_PACKAGES=("./op-acceptance-tests/tests/...")

    # CircleCI test-level splitting: when running under `parallelism: N > 1`,
    # split the test set across CIRCLE_NODE_TOTAL nodes using historical timings
    # so each node runs a balanced subset. Falls back to running everything when
    # CIRCLE_NODE_TOTAL is unset (local runs, single-node CI).
    export NODE_INDEX=${CI_SHARD_INDEX:-${CIRCLE_NODE_INDEX:-0}}
    NODE_TOTAL=${CI_SHARD_TOTAL:-${CIRCLE_NODE_TOTAL:-1}}
    DISCOVERY_DIR="$LOG_DIR/discovery"
    mkdir -p "$DISCOVERY_DIR"
    ASSIGNED="$DISCOVERY_DIR/assigned.txt"
    if [[ -n "${CI_ACCEPTANCE_MANIFEST:-}" ]]; then
        cp "$CI_ACCEPTANCE_MANIFEST/"{manifest.json,packages.json,listing.json} "$DISCOVERY_DIR/"
        python3 ops/ci/runtime/acceptance-manifest.py select --directory "$DISCOVERY_DIR" \
            --total "$NODE_TOTAL" --index "$NODE_INDEX" > "$ASSIGNED"
    else
        # Retain and reject errors from both commands before invoking a splitter.
        go list -e -json "${TEST_PACKAGES[@]}" > "$DISCOVERY_DIR/packages.json"
        go test -list '^Test' -json "${TEST_PACKAGES[@]}" > "$DISCOVERY_DIR/listing.json"
        python3 ops/ci/runtime/acceptance-manifest.py names --directory "$DISCOVERY_DIR" \
            --total "$NODE_TOTAL" > "$DISCOVERY_DIR/names.txt"
        "{{REPO_ROOT}}/ops/scripts/shard-tests.sh" < "$DISCOVERY_DIR/names.txt" > "$ASSIGNED"
    fi
    python3 ops/ci/runtime/acceptance-manifest.py record --directory "$DISCOVERY_DIR" \
        --total "$NODE_TOTAL" --index "$NODE_INDEX" --assigned "$ASSIGNED"

    SHARD_COUNT=$(wc -l < "$ASSIGNED" | tr -d ' ')
    echo "Node $NODE_INDEX/$NODE_TOTAL running $SHARD_COUNT tests:"
    cat "$ASSIGNED"

    # There are far more tests than nodes, so an empty shard means the split failed.
    if [ "$SHARD_COUNT" -eq 0 ]; then
        echo "error: no tests assigned to this node" >&2
        exit 1
    fi

    # Pair each test on this node with the package(s) that have it, in shard order.
    # The pairs come from the recorded selection, which rejects discovery errors.
    python3 ops/ci/runtime/acceptance-manifest.py pairs --directory "$DISCOVERY_DIR" \
        --total "$NODE_TOTAL" > "$LOG_DIR/tests_pairs.txt"

    # Runs one test; passing means a clean exit and the test starting and reporting
    # a pass or skip, since `go test` also passes when -run matches nothing. Exits
    # are only ever 0 or 1 because xargs stops starting tests if a command exits 255
    # or dies from a signal. A failed test keeps its own copy of the output, untangled
    # from the other tests'.
    run_test() {
        local id="$NODE_INDEX-${1//\//.}.$2"
        local failed_log="$LOG_DIR/failed/$id.log"
        {{REPO_ROOT}}/ops/scripts/gotestsum-split.sh \
            --format testname \
            ${SUMMARY_FLAG:+"$SUMMARY_FLAG"} \
            --junitfile "$RESULTS_DIR/results-$id.xml" \
            --jsonfile "$LOG_DIR/raw_go_events-$id.log" \
            -- \
            -count=1 \
            -parallel "$TEST_PARALLEL" \
            -timeout "$TEST_TIMEOUT" \
            -run "^$2\$" \
            "$1" \
            2>&1 | tee "$failed_log"
        if [ "${PIPESTATUS[0]}" -ne 0 ]; then
            return 1
        fi
        # test2json leaves its \u0016 marker on a result line that follows unterminated
        # output at a multiple of 4096 bytes, and drops the test's pass event.
        local events="$LOG_DIR/raw_go_events-$id.log"
        if ! grep -qF "\"Action\":\"run\",\"Package\":\"$1\",\"Test\":\"$2\"" "$events" \
            || ! grep -qE "\"Output\":\"(\\\\u0016)?--- (PASS|SKIP): $2 \(" "$events" \
            || grep -qF "\"Action\":\"fail\",\"Package\":\"$1\",\"Test\":\"$2\"" "$events"; then
            echo "FAIL $1.$2 (go test exited 0 but the test did not run and report a pass or skip)" | tee -a "$failed_log"
            return 1
        fi
        rm "$failed_log"
    }
    export -f run_test
    SUMMARY_FLAG=""
    if [[ "${ACCEPTANCE_TEST_HIDE_FAILURE_OUTPUT:-false}" == true ]]; then
        SUMMARY_FLAG=--hide-summary=output
    fi
    export LOG_LEVEL RESULTS_DIR LOG_DIR TEST_PARALLEL TEST_TIMEOUT SUMMARY_FLAG

    set +e
    xargs -n 2 -P "$JOBS" bash -c 'run_test "$@" </dev/null' _ < "$LOG_DIR/tests_pairs.txt" \
        2>&1 | tee "$LOG_DIR/all.log"
    TEST_STATUS=${PIPESTATUS[0]}
    set -e

    RAN=$(( $(find "$LOG_DIR" -maxdepth 1 -name 'raw_go_events-*' | wc -l) ))
    TOTAL=$(( $(wc -l < "$LOG_DIR/tests_pairs.txt") ))
    FAILED=$(( $(find "$LOG_DIR/failed" -name '*.log' | wc -l) ))
    echo "Ran $RAN of $TOTAL tests, $FAILED failed" | tee -a "$LOG_DIR/all.log"
    ls "$LOG_DIR/failed" | tee -a "$LOG_DIR/all.log"
    if { [ "$RAN" -ne "$TOTAL" ] || [ "$FAILED" -gt 0 ]; } && [ "$TEST_STATUS" -eq 0 ]; then
        echo "error: not every test ran and passed" | tee -a "$LOG_DIR/all.log"
        TEST_STATUS=1
    fi

    cp "$LOG_DIR/all.log" "$LOG_DIR/summary.log"
    exit "$TEST_STATUS"

clean:
    rm -rf tests/interop/loadtest/artifacts
