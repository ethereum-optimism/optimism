    "lint:redirects": "tsx scripts/lint/validate-redirects.ts"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@eth-optimism/actions-sdk": "^0.4.0",
