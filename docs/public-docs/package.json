{
  "name": "optimism-docs",
  "version": "1.0.0",
  "description": "Optimism Documentation",
  "main": "index.js",
  "scripts": {
    "dev": "bun --bun mint dev",
    "prebuild": "bun scripts/generate-actions-components.ts && bun scripts/generate-releases.ts",
    "prebuild:local": "bun scripts/generate-actions-components.ts --local && bun scripts/generate-releases.ts",
    "lint:nav": "bun scripts/lint/validate-nav.ts",
    "lint:redirects": "bun scripts/lint/validate-redirects.ts",
    "lint:reference": "bun scripts/lint/validate-reference.ts",
    "gen:hardforks": "bun scripts/generate-hardforks.ts",
    "gen:hardforks:check": "bun scripts/generate-hardforks.ts --check"
  },
  "devDependencies": {
    "@eth-optimism/actions-sdk": "^0.8.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.0.0",
    "mint": "4.2.1203",
    "ts-morph": "^21.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "minimatch": ">=9.0.7",
    "ws": ">=8.21.0",
    "sharp": "0.35.5"
